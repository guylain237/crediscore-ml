# Données — jamais versionnées.
# La barre oblique initiale ANCRE le motif à la racine du dépôt : sans elle,
# « data/ » ignorerait aussi src/data/, qui est du code livrable.
/input/
/data/
*.csv

# Exception : les resultats d'audit de docs/ sont des livrables, pas des
# donnees. Ce sont eux qui portent les chiffres d'equite et d'explicabilite
# presentes au jury ; les exclure reviendrait a ne versionner que le code qui
# les produit, sans jamais ce qu'il a produit.
!docs/*.csv
*.zip
*.parquet

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Artefacts ML
mlruns/
mlflow.db
mlartifacts/
models/*.pkl
models/*.txt
models/*.joblib
catboost_info/

# Exports de documents — le Markdown de docs/ est la source de vérité.
# Un .docx ou un .pdf versionné diverge du .md dès la première correction :
# on exporte au moment du rendu, on ne stocke pas l'export.
*.docx
*.pdf

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Secrets
.env
*.pem
*.key
