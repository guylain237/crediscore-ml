build/
dist/

# Artefacts ML
mlruns/
mlartifacts/
models/*.pkl
models/*.txt
models/*.joblib
catboost_info/

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Secrets
.env
*.pem
*.key
